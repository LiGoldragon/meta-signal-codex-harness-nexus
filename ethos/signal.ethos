Signal
[ harness:FilePath
  signal_codex_harness_nexus:[ MemoryFault HeldLock ] ]
[ Configure.Set
  Subscribe ]
[ Configured.Set
  Subscribed.Stream<ConfigurationReadout ConfigurationChange>
  ConfigureRefused.ConfigurationRefusal ]
[ NodeLimit.Integer
  DepthLimit.Integer
  TextBudget.{ NodeLimit DepthLimit }
  Capacity.Integer
  FlowsRoot.String
  IdentityProducer.String
  SessionsDirectories.Vector<FilePath>
  ThreadDatabases.Vector<FilePath>
  Set.[ TextBudget
        FlowsRoot
        IdentityProducer
        SessionsDirectories
        ThreadDatabases
        SubscriberCapacity.Capacity ]
  Configuration.{ Option<TextBudget>
                  Option<FlowsRoot>
                  Option<IdentityProducer>
                  Option<SessionsDirectories>
                  Option<ThreadDatabases>
                  Option<Capacity> }
  AwaitedDirectories.Vector<FilePath>
  UnwatchableDirectories.Vector<UnwatchableDirectory>   ; recorded, and not watched, each with why
  ConfigurationReadout.{ Configuration AwaitedDirectories UnwatchableDirectories }
  ConfigurationChange.[ Set
                        AwaitedDirectories
                        UnwatchableDirectories ]
  ConfigurationField.[ TextBudget
                       FlowsRoot
                       IdentityProducer
                       SessionsDirectories
                       ThreadDatabases
                       SubscriberCapacity ]
  Diagnostic.String
  UnwatchableDirectory.{ FilePath Diagnostic }
  ConfigurationRefusal.[ InvalidTextBudget.TextBudget
                         TranslatorSetting
                         InvalidCapacity.Capacity
                         InvalidPath.FilePath
                         Unrecorded.MemoryFault
                         CapacityUnset
                         UnwatchableDirectory
                         Poisoned.HeldLock ] ]
